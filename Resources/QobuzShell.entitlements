<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The app is deliberately NOT sandboxed. It has to write into the Qobuz app
	bundles (Patcher), share ~/Library/Application Support/QobuzShell/ with the
	loader running inside Qobuz, and in Debug builds point that loader at
	custom.css and fonts in the project folder. None of that works sandboxed.
	-->
</dict>
</plist>
